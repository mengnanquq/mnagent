[Unit]
Description=mnagent (mengnanbot nexttrace agent)
Documentation=https://github.com/mengnanquq/mnagent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root

# 令牌放在只有该用户可读的文件里（chmod 0600）。
# 如需启用自动更新，可追加 -auto-update 参数。
ExecStart=/usr/local/bin/mnagent \
    -bot https://mnbot.example.org/agent \
    -token-file /etc/mnagent/token \
    -nexttrace /usr/local/bin/nexttrace \
    -miaospeed /usr/local/bin/miaospeed

# nexttrace 需要可写的主目录来存放配置与 IP 库；ProtectSystem=strict 下只有
# StateDirectory 指向的目录可写。启用自更新时需允许替换可执行文件（ReadWritePaths）。
StateDirectory=mnagent
StateDirectoryMode=0700
Environment=HOME=/var/lib/mnagent
ReadWritePaths=/usr/local/bin

Restart=always
RestartSec=5
# agent 退出时最多用 60s 回传在途结果（见 config.DefaultExitResultTimeout），
# 停止超时必须大于它，否则 systemd 会在结果上传完成前 SIGKILL。
TimeoutStopSec=80

# nexttrace 需要 CAP_NET_RAW 才能做原始套接字追踪：由服务携带 ambient 能力并传给
# 子进程（与 NoNewPrivileges 兼容；比给 nexttrace 二进制 setcap 更稳，二进制被替换后
# 也不会失效）。因此本单元下无需再执行 setcap。
AmbientCapabilities=CAP_NET_RAW CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_RAW CAP_NET_ADMIN

# 基础加固：不提升权限、根文件系统只读、私有 /tmp。
# 注意不要启用 MemoryDenyWriteExecute：它对 Go/第三方二进制并不总是安全，
# 而本服务只需要执行 nexttrace。
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
# 保守加固：只限制本服务不可能用到的内核/设备/命名空间能力。
# 禁止加载/卸载内核模块（nexttrace/miaospeed 都不需要）。
ProtectKernelModules=true
# 禁止读取内核日志（/dev/kmsg、syslog），避免泄露内核地址等信息。
ProtectKernelLogs=true
# 禁止修改系统时钟（NTP 由宿主机负责，agent 无此需求）。
ProtectClock=true
# 禁止修改主机名（agent 不负责主机名管理）。
ProtectHostname=true
# 禁止创建新的 mount/pid/net 等命名空间，降低提权面。
RestrictNamespaces=true
# 禁止使用实时调度策略，避免抢占宿主机实时任务。
RestrictRealtime=true
# 不启用 SystemCallArchitectures=native：32 位用户态二进制跑在 64 位内核上（如树莓派
# 32 位系统）会被拒绝全部系统调用，导致 agent 无法启动。
# 提供最小 /dev（保留 null/zero/random/urandom 等），不暴露物理设备。
PrivateDevices=true
# 只保留服务实际需要的地址族：本地监听/Unix socket、IPv4/IPv6、netlink、
# 以及 nexttrace 的原始套接字（AF_PACKET）所需。
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK AF_PACKET

[Install]
WantedBy=multi-user.target
