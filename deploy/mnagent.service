[Unit]
Description=mnagent (mengnanbot nexttrace agent)
Documentation=https://github.com/mengnanquq/mnagent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root

# 令牌放在只有该用户可读的文件里（chmod 0600）。
# 如需启用自动更新，可追加 -auto-update 参数。
ExecStart=/usr/local/bin/mnagent \
    -bot https://mnbot.example.org/agent \
    -token-file /etc/mnagent/token \
    -nexttrace /usr/local/bin/nexttrace \
    -miaospeed /usr/local/bin/miaospeed

# nexttrace 需要可写的主目录来存放配置与 IP 库；ProtectSystem=strict 下只有
# StateDirectory 指向的目录可写。启用自更新时需允许替换可执行文件（ReadWritePaths）。
StateDirectory=mnagent
Environment=HOME=/var/lib/mnagent
ReadWritePaths=/usr/local/bin

Restart=always
RestartSec=5

# nexttrace 需要 CAP_NET_RAW 才能做原始套接字追踪：由服务携带 ambient 能力并传给
# 子进程（与 NoNewPrivileges 兼容；比给 nexttrace 二进制 setcap 更稳，二进制被替换后
# 也不会失效）。因此本单元下无需再执行 setcap。
AmbientCapabilities=CAP_NET_RAW CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_RAW CAP_NET_ADMIN

# 基础加固：不提升权限、根文件系统只读、私有 /tmp。
# 注意不要启用 MemoryDenyWriteExecute：它对 Go/第三方二进制并不总是安全，
# 而本服务只需要执行 nexttrace。
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
